# Sahaya Reader Backend Configuration
PORT=8080

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Path to Service Account JSON key (or set GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Shared API Token for request authentication
API_AUTH_TOKEN=your-secure-bearer-token
